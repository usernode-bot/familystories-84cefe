{
  "description": "Turn family voices into stories and a family tree",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "🎙️"
  },
  "permissions": [
    {
      "capability": "microphone",
      "reason": "Records a family member telling a story"
    }
  ],
  "secrets": [],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "tests": [
    {
      "id": "timeline.default",
      "name": "Family timeline shows memories",
      "path": "/",
      "expectSelector": "[data-memory]",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "styles/tailwind-input.css",
        "tailwind.config.js"
      ]
    },
    {
      "id": "form.title",
      "name": "Add-memory form is titled Kenangan baru",
      "path": "/",
      "expectSelector": "#memory-form [data-form-title]"
    },
    {
      "name": "First screen explains the app",
      "path": "/",
      "expectText": "Simpan cerita keluarga, dari generasi ke generasi"
    },
    {
      "name": "Empty screen shows the example memories",
      "path": "/?demo=1",
      "expectSelector": "[data-example]",
      "expectText": "Mulai cerita pertama"
    },
    {
      "id": "timeline.people-filter",
      "name": "Timeline can be filtered by family member",
      "path": "/",
      "expectSelector": "[data-person-filter]"
    },
    {
      "id": "timeline.photo",
      "name": "A memory shows its photo",
      "path": "/",
      "expectSelector": "[data-memory] img.memory-photo"
    },
    {
      "id": "timeline.voice",
      "name": "A memory plays its voice note",
      "path": "/",
      "expectSelector": "[data-memory] audio"
    }
  ]
}
