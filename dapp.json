{
  "description": "Turn family voices into stories and a family tree",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "🎙️"
  },
  "secrets": [],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "tests": [
    {
      "id": "timeline.default",
      "name": "Family timeline shows memories",
      "path": "/",
      "expectSelector": "[data-memory]",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "styles/tailwind-input.css",
        "tailwind.config.js"
      ]
    },
    {
      "name": "First screen explains the app",
      "path": "/",
      "expectText": "Simpan cerita keluarga, dari generasi ke generasi"
    },
    {
      "name": "Empty screen shows the example memories",
      "path": "/?demo=1",
      "expectSelector": "[data-example]",
      "expectText": "Mulai cerita pertama"
    }
  ]
}
